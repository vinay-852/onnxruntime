+// A NaN anywhere in the reduced slice must win, not only a leading one.
+// See https://github.com/microsoft/onnxruntime/issues/34001.
+//
+// These assertions run on the CPU EP only: it is the provider whose semantics are being
+// fixed here. Other EPs (CUDA, WebGPU, ...) still implement the old behaviour.
+namespace {
+std::vector<std::unique_ptr<IExecutionProvider>> CpuEpOnly() {
+  std::vector<std::unique_ptr<IExecutionProvider>> eps;
+  auto cpu_ep = DefaultCpuExecutionProvider();
+  if (cpu_ep != nullptr) {
+    eps.push_back(std::move(cpu_ep));
+  }
+  return eps;
+}
+}  // namespace
+
+TEST(ReductionOpTest, ReduceMaxMinNaN) {
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  auto run = [](const char* op, const std::vector<int64_t>& input_dims, const std::vector<float>& data,
+                const std::vector<int64_t>& axes, const std::vector<int64_t>& expected_dims,
+                const std::vector<float>& expected) {
+    auto eps = CpuEpOnly();
+    if (eps.empty()) return;
+    OpTester test(op, 18);
+    test.AddAttribute("keepdims", static_cast<int64_t>(0));
+    test.AddInput<float>("data", input_dims, data);
+    test.AddInput<int64_t>("axes", {static_cast<int64_t>(axes.size())}, axes);
+    test.AddOutput<float>("reduced", expected_dims, expected);
+    test.Run(OpTester::ExpectResult::kExpectSuccess, "", {}, nullptr, &eps);
+  };
+
+  // Whole slice (aggall path).
+  run("ReduceMax", {3}, {1.0f, nan, 3.0f}, {0}, {}, {nan});
+  run("ReduceMin", {3}, {1.0f, nan, 3.0f}, {0}, {}, {nan});
+  // kKR: contiguous last axis.
+  run("ReduceMax", {2, 3}, {1.0f, nan, 3.0f, nan, 1.0f, 3.0f}, {1}, {2}, {nan, nan});
+  run("ReduceMin", {2, 3}, {1.0f, nan, 3.0f, nan, 1.0f, 3.0f}, {1}, {2}, {nan, nan});
+  // Axis 0 below the kRK size threshold: exercises the scalar fallback.
+  run("ReduceMax", {3, 2}, {1.0f, 1.0f, nan, 2.0f, 3.0f, 3.0f}, {0}, {2}, {nan, 3.0f});
+  run("ReduceMin", {3, 2}, {1.0f, 1.0f, nan, 2.0f, 3.0f, 3.0f}, {0}, {2}, {nan, 1.0f});
+  // kKRK: middle axis of a 3-D input.
+  run("ReduceMax", {2, 3, 2}, {1, 1, nan, 2, 3, 3, 4, 4, 5, nan, 6, 6}, {1}, {2, 2}, {nan, 3, 6, nan});
+  run("ReduceMin", {2, 3, 2}, {1, 1, nan, 2, 3, 3, 4, 4, 5, nan, 6, 6}, {1}, {2, 2}, {nan, 1, 4, nan});
+  // kRKR: non-contiguous multi-axis.
+  run("ReduceMax", {2, 3, 2}, {1, 1, nan, 2, 3, 3, 4, 4, 5, nan, 6, 6}, {0, 2}, {3}, {4, nan, 6});
+  run("ReduceMin", {2, 3, 2}, {1, 1, nan, 2, 3, 3, 4, 4, 5, nan, 6, 6}, {0, 2}, {3}, {1, nan, 3});
+}
+
+// The kRK dispatcher only takes the fast path above a size threshold, so pin the intra-op
+// thread count to make the shape below exercise FastReduceRK instead of the scalar fallback.
+TEST(ReductionOpTest, ReduceMaxMinNaNStridedFastPath) {
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  constexpr int64_t rows = 513;
+  std::vector<float> data;
+  data.reserve(static_cast<size_t>(rows * 2));
+  data.push_back(1.0f);
+  data.push_back(2.0f);
+  data.push_back(nan);  // column 0: NaN after the first row
+  data.push_back(3.0f);
+  for (int64_t r = 2; r < rows; ++r) {
+    data.push_back(static_cast<float>(r));
+    data.push_back(static_cast<float>(r + 1));
+  }
+
+  auto eps = CpuEpOnly();
+  if (eps.empty()) return;
+
+  SessionOptions so;
+  so.intra_op_param.thread_pool_size = 1;
+
+  for (const auto& [op, expected] : std::vector<std::pair<const char*, std::vector<float>>>{
+           {"ReduceMax", {nan, static_cast<float>(rows)}},
+           {"ReduceMin", {nan, 2.0f}}}) {
+    auto run_eps = CpuEpOnly();
+    OpTester test(op, 18);
+    test.AddAttribute("keepdims", static_cast<int64_t>(0));
+    test.AddInput<float>("data", {rows, 2}, data);
+    test.AddInput<int64_t>("axes", {1}, {0});
+    test.AddOutput<float>("reduced", {2}, expected);
+    test.Run(so, OpTester::ExpectResult::kExpectSuccess, "", {}, nullptr, &run_eps);
+  }
+}
+
+TEST(ReductionOpTest, ArgMaxArgMinNaN) {
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  auto run = [](const char* op, const std::vector<int64_t>& input_dims, const std::vector<float>& data,
+                int64_t axis, int64_t select_last_index, const std::vector<int64_t>& expected_dims,
+                const std::vector<int64_t>& expected) {
+    auto eps = CpuEpOnly();
+    if (eps.empty()) return;
+    OpTester test(op, 13);
+    test.AddAttribute("axis", axis);
+    test.AddAttribute("keepdims", static_cast<int64_t>(0));
+    test.AddAttribute("select_last_index", select_last_index);
+    test.AddInput<float>("data", input_dims, data);
+    test.AddOutput<int64_t>("reduced", expected_dims, expected);
+    test.Run(OpTester::ExpectResult::kExpectSuccess, "", {}, nullptr, &eps);
+  };
+
+  // Index of the first NaN (loop path).
+  run("ArgMax", {2, 3}, {1.0f, nan, 3.0f, nan, 1.0f, 3.0f}, 1, 0, {2}, {1, 0});
+  run("ArgMin", {2, 3}, {1.0f, nan, 3.0f, nan, 1.0f, 3.0f}, 1, 0, {2}, {1, 0});
+  // Index of the first NaN (whole-slice path).
+  run("ArgMax", {3}, {1.0f, 3.0f, nan}, 0, 0, {}, {2});
+  run("ArgMin", {3}, {1.0f, 3.0f, nan}, 0, 0, {}, {2});
+  // Several NaNs: select_last_index=0 keeps the first one, =1 keeps the last one.
+  run("ArgMax", {2, 4}, {1.0f, nan, 3.0f, nan, nan, 1.0f, nan, 3.0f}, 1, 0, {2}, {1, 0});
+  run("ArgMin", {2, 4}, {1.0f, nan, 3.0f, nan, nan, 1.0f, nan, 3.0f}, 1, 0, {2}, {1, 0});
+  run("ArgMax", {2, 4}, {1.0f, nan, 3.0f, nan, nan, 1.0f, nan, 3.0f}, 1, 1, {2}, {3, 2});
+  run("ArgMin", {2, 4}, {1.0f, nan, 3.0f, nan, nan, 1.0f, nan, 3.0f}, 1, 1, {2}, {3, 2});
+}
+
 TEST(ReductionOpTest, ReduceProd_EmptySet_DefaultAxes_KeepDims) {
   OpTester test("ReduceProd", 18);
   test.AddAttribute("keepdims", (int64_t)1);
